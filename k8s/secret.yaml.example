# Example Kubernetes Secret template for Notion Press
# Copy this file to k8s/secret.yaml and replace with your real keys:
# kubectl apply -f k8s/secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: notionpress-secrets
  namespace: notion-press
type: Opaque
stringData:
  API_AUTH_KEY: "your-api-auth-key-placeholder"
  OPENROUTER_API_KEY: "your-openrouter-api-key-placeholder"

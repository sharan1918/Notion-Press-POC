# LLM provider credentials
# Use OpenRouter when routing multiple models through one API.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-001

# Same model order as the previous direct-provider implementation.
OPENROUTER_PRIMARY_MODEL=openai/gpt-oss-120b
OPENROUTER_SECONDARY_MODEL=google/gemini-3.6-flash
OPENROUTER_TERTIARY_MODEL=openai/gpt-oss-20b

# Application settings
ENVIRONMENT=development
API_AUTH_KEY=notion-poc-author-key-2026
TRIAGE_CONCURRENCY=2
TRIAGE_DELAY_SECONDS=0.5
